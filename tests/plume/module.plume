/// Test params 1
$import(tests/plume/toimport/param)
/// Output
10
/// End

/// Test params 2
$import(tests/plume/toimport/param, x: 5)
/// Output
5
/// End

/// Test use params
use tests/plume/toimport/useparam(x: 5)
$x
/// Output
5
/// End

/// Test params with cache
$import(tests/plume/toimport/param, x: 5)\n
$import(tests/plume/toimport/param)
/// Output
5
10
/// End

/// Test use params with cache
use tests/plume/toimport/useparam(x: 5)
$x\n
use tests/plume/toimport/useparam()
$x
/// Output
5
10
/// End

/// Test variadic param
$import(tests/plume/toimport/param2, x:5, y:57)
/// Output
(5: x, 57: y)
/// End

/// Test use variadic param
use tests/plume/toimport/param2(x:z, y:a)
$z$a
/// Output
xy
/// End

/// Test variadic param as name
$import(tests/plume/toimport/param2, leftover: 5)
/// Output
$Table(5: leftover)
/// End

/// Test positionnal param
$import(tests/plume/toimport/param3, a, b)
/// Output
(x: a - b)
/// End

/// Test use positionnal param
use tests/plume/toimport/param3(a, b)
$x
/// Output
a - b
/// End

/// Test upvalue with cache
use tests/plume/toimport/inc
$inc()\n
$inc()\n
use tests/plume/toimport/inc
$inc()\n
$inc()\n
$inc()\n
/// Output
1
2
1
2
3
/// End

/// Test cycle in use
use tests/plume/toimport/loop2
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cycle in use: tests/plume/toimport/loop2.plume ->                            │
│   tests/plume/toimport/loop2.plume                                             │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ tests/plume/toimport/loop2.plume                                            │
│    1 │use tests/plume/toimport/loop2                                           │
│      │    ^^^^^^^^^^^^^^^^^^^^^^^^^^                                           │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ test.plume                                                                  │
│    1 │use tests/plume/toimport/loop2                                           │
│      │    ^^^^^^^^^^^^^^^^^^^^^^^^^^                                           │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test Escape in use param
use tests/plume/toimport/lib2(info2: \s\s)
$wing()
/// Output
blue   quill
/// End

/// Test trim
use tests/plume/toimport/lib2 
$wing()
/// Output
blue quill
/// End

/// Test import cache 1
use #future(importCache)
let lib1 = $import(tests/plume/toimport/object)
let lib2 = $import(tests/plume/toimport/object)
$(lib1.result == lib2.result)
/// Output
true
/// End

/// Test import cache 2
use #future(importCache)
use tests/plume/toimport/object
let lib = $import(tests/plume/toimport/object)
$(result == lib.result)
/// Output
true
/// End

