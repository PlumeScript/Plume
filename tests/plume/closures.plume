/// Test Capture "global"
let value = 5
macro Wing
  $value
end
$Wing()
/// Output
5
/// End

/// Test Capture inside macro
macro makeClosure
   let a = 10
   let b = 20
   macro ()
      $a$b
   end
end
let f = $makeClosure()
$f()
/// Output
1020
/// End


/// Test Capture nested scopes 1
macro makeClosure
   let a = 10

   if true
      let b = 20
      macro ()
         $a$b
      end
   end
end
let f = $makeClosure()
$f()
/// Output
1020
/// End

/// Test Capture nested scopes 2
macro makeClosure
   let a = 10
   let b = 20
   macro ()
      if true
         $a$b
      end
   end
end
let f = $makeClosure()
$f()
/// Output
1020
/// End

/// Test Chained closures
macro A
end

macro B
    $A()
end

macro C
end

macro D
    $B()
    $C()
end

$D()
/// Output

/// End


/// Test Mutation
macro makeCounter
  let count = 0
  macro()
    set count += 1
    $count
  end
end

let counter = $makeCounter()
$counter()
$counter()
/// Output
12
/// End

/// Test Nested Macros 1
macro grandPa
  let secret = GP

  macro()
    macro()
      $secret
    end
  end
end

let f = $grandPa()
$f()()
/// Output
GP
/// End

/// Test Nested Macros 2
macro grandPa
  let secret = GP

  macro()
    macro()
      macro()
         $secret
      end
    end
  end
end

let f = $grandPa()
$f()()()
/// Output
GP
/// End

/// Test Setter getter
macro createBox
  let value = 0
  _set: macro(v)
    set value = $v
  end
  _get: macro()
    $value
  end
end

let box = $createBox()
$box._set(42)
$box._get()
/// Output
42
/// End

/// Test rec
macro rec(n)
   if n==0
      macro(x)
         return $x
      end
   else
      let f_rec = $ rec(n-1)
      macro(x)
         return $ n * f_rec(x)
      end
   end
end

let f = $rec(3)
$f(2)
/// Output
12
/// End

/// Test meta
let x = 5

let t = do
    meta call: macro()
        $x
    end
end

$t()
/// Output
5
/// End

/// Test ref 1
let t = do
   ref x: 5
   macro y
      $x
   end
   z: $y()
end
$t.z
/// Output
5
/// End

/// Test ref 2
let t = do
   ref x: 5
   y: macro
      $x
   end
end
$t.y()
/// Output
5
/// End

/// Test ref import
let nib from $import(tests/plume/toimport/lib3)
$nib()
/// Output
Wing!Wing!
/// End

/// Test Sibling upvalue capture
macro helper
   H
end

let t = do
   ref box: macro
      a: macro
         $ helper()
         $ box()
      end
      b: macro
         $ helper()
      end
   end
end
$t.box().b()
/// Output
H
/// End

/// Test Sibling upvalue capture 2
macro helper1
   1
end
macro helper2
   2
end

let t = do
   ref box: macro
      a: macro
         $ helper1()
         $ helper2()
         $ box()
      end
      b: macro
         $ helper2()
      end
   end
end
$t.box().b()
/// Output
2
/// End

/// Test Sibling upvalue capture nested
macro helper
   H
end

let t = do
   ref outer: macro
      mid: macro
         a: macro
            $ helper()
            $ outer()
         end
         b: macro
            $ helper()
         end
      end
   end
end
$t.outer().mid().b()
/// Output
H
/// End

/// Test Sibling ref upvalue capture
macro helper
   H
end

let t = do
   ref box: macro
      val: 42
      a: macro
         $ box()
         $ helper()
      end
      b: macro
         $box().val
      end
   end
end
$t.box().b()
/// Output
42
/// End

/// Test Sibling upvalue mutation
let t = do
   let count = 0
   ref box: macro
      a: macro()
         $ count
         $ box()
      end
      b: macro()
         set count += 1
         $ count
      end
   end
end
$t.box().b()
$t.box().b()
/// Output
12
/// End

/// Test Sibling upvalue capture last
macro helper
   H
end

let t = do
   ref box: macro
      a: macro
         $ box()
      end
      b: macro
         $ helper()
      end
   end
end
$t.box().b()
/// Output
H
/// End
