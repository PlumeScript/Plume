/// Test addr
let t = do
  meta addr: macro(x)
    $(x+1)
  end
end
$(t+1)
/// Output
2
/// End

/// Test addl
let t = do
  meta addl: macro(x)
    $(x+1)
  end
end
$(1+t)
/// Output
2
/// End

/// Test add fallback 1
let t = do
  meta add: macro(x, y)
    $(y+1)
  end
end
$(t+1)
/// Output
2
/// End

/// Test add fallback 2
let t = do
  meta add: macro(x, y)
    $(x+1)
  end
end
$(1+t)
/// Output
2
/// End

/// Test self access
let t = do
  value: 10
  meta add: macro(x, y)
    $(self.value+y)
  end
end
$(t+1)
/// Output
11
/// End

/// Test mul
let t = do
  meta mulr: macro(x)
    $(x+1)
  end
end
$(t*2)
/// Output
3
/// End

/// Test sub
let t = do
  meta subr: macro(x)
    $(x+1)
  end
end
$(t-2)
/// Output
3
/// End

/// Test div
let t = do
  meta divr: macro(x)
    $(x+1)
  end
end
$(t/2)
/// Output
3
/// End

/// Test pow
let t = do
  meta powr: macro(x)
    $(x+1)
  end
end
$(t^2)
/// Output
3
/// End

/// Test mod
let t = do
  meta modr: macro(x)
    $(x+1)
  end
end
$(t%2)
/// Output
3
/// End

/// Test minus
let t = do
  meta minus: macro()
    $(-1)
  end
end
$(-t)
/// Output
-1
/// End

/// Test call
let t = do
  meta call: macro()
    I'm a called table
  end
end

$t()
/// Output
I'm a called table
/// End

/// Test call with self
let t = do
  value: 5
  meta call: macro()
    My value is $self.value
  end
end

$t()
/// Output
My value is 5
/// End

/// Test eq
let t = do
  meta eq: macro(x, y)
    $true
  end
end

$(t==6)
/// Output
true
/// End

/// Test neq fallback
let t = do
  meta eq: macro(x, y)
    $true
  end
end

$(t!=6)
/// Output
false
/// End

/// Test lt
let t = do
  meta lt: macro(x, y)
    $true
  end
end

$(t<6)
/// Output
true
/// End

/// Test lt fallback 1
let t = do
  meta lt: macro(x, y)
    $true
  end
end

$(t>6)
/// Output
true
/// End

/// Test lt fallback 2
let t = do
  meta lt: macro(x, y)
    $true
  end
end

$(t>=6)
/// Output
false
/// End

/// Test tostring 1
let t = do
  meta tostring: macro()
    I'm a table
  end
end

t says "$t".
/// Output
t says "I'm a table".
/// End

/// Test tostring 2
let t = do
  meta tostring: macro()
    I'm a table
  end
end

$(String(t))
/// Output
I'm a table
/// End

/// Test getindex 1
let t = do
  meta getindex: macro(name)
    WING
  end
end

$t.quill\n
$t.nib
/// Output
WING
WING
/// End

/// Test getindex 2
let t = do
  meta getindex: macro(name)
    $name
  end
end

$t.quill\n
$t.nib
/// Output
quill
nib
/// End

/// Test setindex 1
let side = 0
let t = do
  meta setindex: macro(name, value)
    set side = 1
  end
end
$side
set t.quill = 5
$side
/// Output
01
/// End

/// Test setindex 2
let side = 0
let t = do
  meta setindex: macro(name, value)
    set side = 1
  end
end
$side
$rawset($t, quill, 5)
$side
$t.quill
/// Output
005
/// End

/// Test readonly
let t = do
  meta readonly: $true
  wing: red
end

let m = $Table.getMeta($t)
set m.readonly = $false

set t.wing = blue
/// Output
/// End

/// Test tostring simple value
let t = do
  meta tostring: I'm a table.
end

$String($t)
/// Output
I'm a table.
/// End

/// Test tostring
let t = do
    x: x
    meta tostring: macro()
        $self.x
    end
end

$String($t)
/// Output
x
/// End

/// Test meta add
macro Vect(x, y)
    x: $x
    y: $y
    meta add: macro(_, v)
        @Vect
            - $(self.x + v.x)
            - $(self.y + v.y)
        end
    end
end
    
with ($plume.locale: none)
    let A = $Vect(1, 0.5) 
    let B = $Vect(7, 0.5)
    $(A+B)
end
/// Output
(x: 8, y: 1)
/// End

/// Test tostring String
let t = do
    meta tostring: $String
end
/// Output
/// End

/// Test tostring interpolation
let wing = do
    meta tostring: macro()
        a$(1+1)
    end
end

a$wing
/// Output
aa2
/// End

/// Test tostring fragment
let wing = do
    meta tostring: macro()
        meta fragment: macro()
            nib
        end
    end
end

a$wing
/// Output
anib
/// End

/// Test nested tostring
let wing = do
    meta tostring: macro()
        meta tostring: macro()
            nib
        end
    end
end

a$wing
/// Output
anib
/// End
