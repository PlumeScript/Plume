/// Test Table get indewrite
let t = $Table(mark, quill, ink)
$t[1]
/// Output
mark
/// End

/// Test Table set indewrite
let t = $Table(mark, quill, ink)
set t[1] = wing
$t[1]
/// Output
wing
/// End

/// Test Table write expand 1
let t1 = $Table(write, paint, make)

let t2 = do
	...t1
end

@Table.join(sep: \s)
	...t2
end
/// Output
write paint make
/// End

/// Test Table write expand 2
let t1 = $Table(write, paint, make)

let t2 = do
	- ink
	...t1
	- quill
end

@Table.join(sep: \s)
	...t2
end
/// Output
ink write paint make quill
/// End

/// Test Table write expand 3
let t1 = $Table(write: quill, paint: song)

let t2 = do
	...t1
end

$t2.write\n
$t2.paint
/// Output
quill
song
/// End

/// Test Table write expand 4
let t1 = $Table(write: quill, paint: song)

let t2 = do
	write: nib
	...t1
	paint: words
end

$t2.write\n
$t2.paint
/// Output
quill
words
/// End

/// Test Table ewritepand inline
let t = do
	- write
	- paint
	- song
	quill: mark
end

macro wing(write, paint, z, quill: word)
	$write - $paint - $z - $quill
end

$wing(...t)

/// Output
write - paint - song - mark
/// End

/// Test Table set
let t = do
	- write
	- paint
	- song
end
$t[1]\n
set t[1] = mark
$t[1]
/// Output
write
mark
/// End

/// Test safe index 1
let t = $Table(a:b)
$t.a?
$ t.a?
/// Output
bb
/// End

/// Test safe index 2
let t = $Table(a:b)
$t.b?
$ t.b? or 1
/// Output
1
/// End

/// Test safe index 3
let t = $Table(a:b)
$t["a"]?
$ t["a"]?
/// Output
bb
/// End

/// Test safe index 4
let t = $Table(a:b)
$t["b"]?
$ t["b"]? or 1
/// Output
1
/// End

/// Test dynamic keys 1
let x = wing
let t = do
	$x: nib
end

$t.wing
/// Output
nib
/// End

/// Test dynamic keys 2
let x = wing
let t = $Table($x: nib)

$t.wing
/// Output
nib
/// End

/// Test dynamic keys 3
let x = wing
let t = $(Table($x: "nib"))

$t.wing
/// Output
nib
/// End

/// Test ref 1
let t = do
	ref x: 1
	y: $x
end
$t.y
/// Output
1
/// End

/// Test ref 2
let t = do
	ref x: 1
	z: aaaa
	y: $x
end
$t.y
/// Output
1
/// End

/// Test ref 3
let t = do
	ref x: 1
	if true
		y: $x
	end
end
$t.y
/// Output
1
/// End

/// Test ref 4
let t = do
	ref x: 1
	y: $x$x$x
end
$t.y
/// Output
111
/// End

/// Test ref 5
let t = do
	ref x: 1
	y: @Table.join
		a$x\0aaa
	end
end
$t.y
/// Output
a1aaa
/// End

/// Test ref  empty 1
let t = do
	ref x
	y: $x
end
$t.y
/// Output
/// End

/// Test ref  empty 2
let t = do
	ref x
	x: 5
	y: $x
end
$t.y
/// Output
5
/// End

/// Test ref change
let t = do
	ref x: 5
	x: $(x+1)
end
$t.x
/// Output
6
/// End

/// Test ref alias
let t = do
	ref x as z: 1
	y: @Table.join
		a$z\0aaa
	end
end
$t.y
/// Output
a1aaa
/// End

/// Test inline Table
let t = (1, 2, a:b)
$t[1]$t.a
/// Output
1b
/// End

/// Test inline Table - eval
let t = $((1+2, 2, a:"b"))
$t[1]$t.a
/// Output
3b
/// End

/// Test inline Table nested
let t = (1, (1, 2), a:b)
$t[2][1]
/// Output
1
/// End

/// Test inline Table in call
$len((1, 2, 3))
/// Output
3
/// End

/// Test inline Table in call - eval
$ len((1, 2, 3))
/// Output
3
/// End

/// Test inline Table as inline Table value 1
let t = (1, a:(1, 2))
$ repr(t)
/// Output
(1, a: (1, 2))
/// End

/// Test inline Table as inline Table value 2
let t = (a:(1, 2))
$ repr(t)
/// Output
(a: (1, 2))
/// End

/// Test inline Table as inline Table value 3
let t = $((1, a:(1, 2)))
$ repr(t)
/// Output
(1, a: (1, 2))
/// End

/// Test inline Table in as named arg
macro wing(nib:$Table())
	$Table.join(...nib)
end

$wing(nib:(1, 2, 3))
/// Output
123
/// End

/// Test ref error
let t = do
	let x
	ref x: 5
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot define variable 'x', it already exists in the current scope.          │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    2 │ let x                                                                   │
│    3 │ ref x: 5                                                                │
│      │ ^^^^^^^^                                                                │
│    4 │end                                                                      │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test ref define itself
ref x: do
	$x
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use the value of `x` to define `x` itself.                            │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    2 │ $x                                                                      │
│      │  ^                                                                      │
│    3 │end                                                                      │
│                                                                                │
│  ↳ (same file)                                                                 │
│    1 │ref x: do                                                                │
│      │^^^^^^^^^                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test ref use itself
ref x: macro()
	$x
end
/// Output
(x: macro<x>)
/// End

/// Test ref use same name
ref x: do
	let x
	$x
end
/// Output
(x: )
/// End

/// Test block expand
macro wing(x)
	- a
	- b
	- $x
end

...@wing
	c
end
/// Output
(a, b, c)
/// End

/// Test table index
let t = $Table(wing)
let index = 1

$t[index]
/// Output
wing
/// End

/// Test nested table set
let t = do
    - do
        wing: blue
    end
end

set t[1].wing = red
/// Output

/// End

/// Test table in if branches
let t = $Table()
let t2 = if false
    $t
else
    $t
end
/// Output

/// End

/// Test table comment
// Space after "Table", but no comment
let t = $Table() 
a
/// Output
a
/// End

/// Test do if else item
let t = do
  if false
  else
    - item
  end
end

$ len(t)
/// Output
1
/// End

/// Test table false value
let t = $Table(x: $false)
$t.x
/// Output
false
/// End

/// Test table remove iterate
let t = $Table(wing, nib)
run $Table.remove($t)

for k, v in items(t)
    $k → $v\n
end
/// Output
1 → wing
/// End

/// Test table spread join
let t1 = $Table(a, b, c)
let t2 = $(Table(...t1))
$Table.join(...t2)
/// Output
abc
/// End

/// Test table empty item
let t = do
    - b
    -
end
$t
/// Output
(b, )
/// End

/// Test table empty value
let t = do
    a:
    c: a
end
$t
/// Output
(a: , c: a)
/// End

/// Test ref multiple
ref x, y, z
/// Output
$Table()
/// End

/// Test table value tuple
let x = a

$x: (5, 2, 3)

/// Output
(a: (5, 2, 3))
/// End

/// Test table sort compare
let x = 5
macro comp(a, b)
    $ x>a
end

let t = (1, 2, 3)
$Table.sort($t, compare: $comp)
/// Output
/// End

/// Test table sort macro
let w = (1, 3, 2)
run $Table.sort($w, compare: macro (a, b) $(a < b))
$w
/// Output
(1, 2, 3)
/// End

/// Test table sort nested
let  t = do
    - (10, 2)
    - (2, 1)
end

run @Table.sort($t)
    compare: macro(x, y)
        return $(x[1]<y[1])
    end
end

$t
/// Output
((2, 1), (10, 2))
/// End

/// Test macro key
let t = do
  quill: macro()
    mark
  end
end
$t.quill()
/// Output
mark
/// End

/// Test macro item
let t = do
  - macro()
    mark
  end
end
$t[1]()
/// Output
mark
/// End

/// Test self by key
let t = do
  mark: song
  quill: macro()
     $self.mark
  end
end

$t.quill()
/// Output
song
/// End

/// Test self by index
let t = do
  mark: song
  - macro()
     $self.mark
  end
end

$t[1]()
/// Output
song
/// End

/// Test self chained
let obj = do
  wings: quill
  method1: macro()
    $self.wings
  end

  method2: macro()
    $self.method1()
  end
end

$obj.wings

/// Output
quill
/// End

/// Test block form Table
let t = do
    wing: macro(body)
        Write "$body"
    end
end

@t.wing
  paint the quill
end

/// Output
Write "paint the quill"
/// End

/// Test table macro block
let t = do
  mark: song
  quill: macro(write)
    $write $self.mark
  end
end

@t.quill
    write
end
/// Output
write song
/// End

/// Test table macro value
let x = a

$x: macro()
    y
end

/// Output
(a: macro<???>)
/// End
