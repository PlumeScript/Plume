/// Test simple return
macro wing()
	return nib
end
$wing()
/// Output
nib
/// End

/// Test eval in return
macro wing()
	let nib = 6
	return $nib
end
$wing()
/// Output
6
/// End

/// Test multiple return
macro wing(x)
	if x>5
		return yes
	else
		return no
	end
end
$wing(10)\n
$wing(2)
/// Output
yes
no
/// End

/// Test return in for
macro wing()
	for i in seq(4)
		if i==3
			return $i
		end
	end
end

$wing()
/// Output
3
/// End

/// Test unbalanced return emit empty
macro wing()
	if false
		return 5
	end
end

$type($wing())
/// Output
empty
/// End

/// Test return in lib
$import(tests/plume/toimport/return)
/// Output
5
/// End

/// Test return in text block
macro wing(x)
	Hello!
	return 4
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ SYNTAX ERROR:                                                                  │
│ → Invalid 'RETURN' content in a 'TEXT' block.                                  │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    Reading this line, Plume assumes the block type is 'TEXT'.                  │
│    1 │macro wing(x)                                                            │
│    2 │ Hello!                                                                  │
│      │ ^^^^^^                                                                  │
│                                                                                │
│    But you try to add a 'RETURN' element.                                      │
│    3 │return 4                                                                 │
│      │^^^^^^^^                                                                 │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test return no value
macro wing()
	return
end

$type($wing())
/// Output
empty
/// End

/// Test return in table block
macro wing(x)
	- Hello!
	return 4
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ SYNTAX ERROR:                                                                  │
│ → Invalid 'RETURN' content in a 'TABLE' block.                                 │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    Reading this line, Plume assumes the block type is 'TABLE'.                 │
│    1 │macro wing(x)                                                            │
│    2 │ - Hello!                                                                │
│      │ ^^^^^^^^                                                                │
│                                                                                │
│    But you try to add a 'RETURN' element.                                      │
│    3 │return 4                                                                 │
│      │^^^^^^^^                                                                 │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End


/// Test return in nested text block 1
macro wing(x)
	run do
		Hello!
		return 4
	end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ SYNTAX ERROR:                                                                  │
│ → Invalid 'RETURN' content in a 'TEXT' block.                                  │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    Reading this line, Plume assumes the block type is 'TEXT'.                  │
│    1 │macro wing(x)                                                            │
│    2 │ run do                                                                  │
│    3 │  Hello!                                                                 │
│      │  ^^^^^^                                                                 │
│                                                                                │
│    But you try to add a 'RETURN' element.                                      │
│    4 │return 4                                                                 │
│      │^^^^^^^^                                                                 │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test return in nested text block 2
macro wing(x)
	Hello!
	do
		let x = 5
		return 4
	end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ SYNTAX ERROR:                                                                  │
│ → Invalid 'RETURN' content in a 'TEXT' block.                                  │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    Reading this line, Plume assumes the block type is 'TEXT'.                  │
│    1 │macro wing(x)                                                            │
│    2 │ Hello!                                                                  │
│      │ ^^^^^^                                                                  │
│    3 │ do                                                                      │
│                                                                                │
│    But you try to add a 'RETURN' element.                                      │
│    5 │return 4                                                                 │
│      │^^^^^^^^                                                                 │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test return in raise
macro wing(x)
	raise do
		return 4
	end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Raise block must be 'TEXT', not 'RETURN'                                     │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing(x)                                                            │
│    2 │ raise do                                                                │
│      │ ^^^^^^^^                                                                │
│    3 │  return 4                                                               │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test return during a call
macro wing(x)
	@print
		return 4
	end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use return keyword inside a call.                                     │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing(x)                                                            │
│    2 │ @print                                                                  │
│    3 │  return 4                                                               │
│      │  ^^^^^^^^                                                               │
│    4 │ end                                                                     │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End
