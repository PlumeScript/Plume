/// Test simple doc
// double the number
macro double(x)
	$(2*x)
end
$(plume.doc(double))
/// Output
macro double(x)
    double the number
/// End

/// Test multiple line
// double the number
// @param x number the number to double
macro double(x)
	$(2*x)
end
$(plume.doc(double))
/// Output
macro double(x)
    double the number
    @param x number the number to double
/// End

/// Test blank line
// This is a test file

// double the number
// @param x number the number to double
macro double(x)
	$(2*x)
end
$(plume.doc(double))
/// Output
macro double(x)
    double the number
    @param x number the number to double
/// End

/// Test Table
// This is a table
let t = do
    - 1
end
$(plume.doc(t))
/// Output
table t
    This is a table
/// End

/// Test File
// This is a table
let lib = $import(tests/plume/toimport/filedoc)
$plume.doc($lib)
/// Output
table tests/plume/toimport/filedoc.plume
    This file do somethings
/// End

/// Test std
// This is a table
$plume.doc($String.lines)
/// Output
luaMacro lines
    `lines(s)`: Splits the string into a slice of individual lines.
/// End

/// Test nodoc
macro wing()
end

$plume.doc($wing)
/// Output
macro wing()
/// End


/// Test closure
let x
macro wing()
    $x
end

$plume.doc($wing)
/// Output
macro wing()
/// End

/// Test macro as value
// a macro that fly
let wing = macro ()
end

$plume.doc($wing)
/// Output
macro wing()
    a macro that fly
/// End

/// Test macro as table value
// a macro that fly
let t = do
    wing: macro ()
    end
end

$plume.doc($t.wing)
/// Output
macro wing()
    a macro that fly
/// End

/// Test macro as ref table value
// a macro that fly
let t = do
    ref wing: macro ()
    end
end

$plume.doc($t.wing)
/// Output
macro wing()
    a macro that fly
/// End

