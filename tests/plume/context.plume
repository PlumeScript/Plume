/// Test simple context
let wing = $Context()
with ($wing: blue)
  $wing()
end
/// Output
blue
/// End

/// Test nested context
let wing = $Context()
with ($wing: blue)
  with ($wing: red)
    $wing()
  end
end
/// Output
red
/// End

/// Test context from file
with ($plume.locale: fr)
  $import(tests/plume/toimport/numbers)
end
/// Output
x = 654 237,458 9
/// End

/// Test context from directive
use #context(locale: fr)
Voici un nombre: $(6543.56)
/// Output
Voici un nombre: 6 543,56
/// End


/// Test read context
let locale = $Context()
$locale()\n
with ($locale: fr)
  $locale()\n
  with ($locale: en)
    $locale()\n
  end
  $locale()
end
/// Output
fr
en
fr
/// End

/// Test context & closure
use #context(locale: fr)
macro Wing()
  $plume.locale()
end
$Wing()
/// Output
fr
/// End

/// Test context block 1
let wing  = $Context()
let t = do
  - item 1
  - with ($wing: red)
    item 2
  end
end
$repr($t)
/// Output
(item 1, item 2)
/// End

/// Test default context 2
let x = $Context(5)

$x()
/// Output
5
/// End