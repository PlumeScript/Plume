/// Test simple context
let wing = $Context()
with ($wing: blue)
  $wing()
end
/// Output
blue
/// End

/// Test nested context
let wing = $Context()
with ($wing: blue)
  with ($wing: red)
    $wing()
  end
end
/// Output
red
/// End

/// Test context from file
with ($plume.locale: fr)
  $import(tests/plume/toimport/numbers)
end
/// Output
x = 654 237,458 9
/// End

/// Test context from directive
use #context(locale: fr)
Voici un nombre: $(6543.56)
/// Output
Voici un nombre: 6 543,56
/// End


/// Test read context
let locale = $Context()
$locale()\n
with ($locale: fr)
  $locale()\n
  with ($locale: en)
    $locale()\n
  end
  $locale()
end
/// Output
fr
en
fr
/// End

/// Test context & closure
use #context(locale: fr)
macro Wing
  $plume.locale()
end
$Wing()
/// Output
fr
/// End

/// Test context block 1
let wing  = $Context()
let t = do
  - item 1
  - with ($wing: red)
    item 2
  end
end
$ repr(t)
/// Output
(item 1, item 2)
/// End

/// Test default context 2
let x = $Context(5)

$x()
/// Output
5
/// End

/// Test raw numbers 1
use #context(locale: fr)
use #rawNumbers

\s$(1005.5)
/// Output
1005.5
/// End

/// Test raw numbers via import
use #context(locale: fr)
let m = $import(tests/plume/toimport/numberraw)
$m()
/// Output
x is 5200.6!
/// End

/// Test context locale random
use #context(locale: fr)
wing
if Random()()>2
end
/// Output
wing
/// End

/// Test context in macro
let x = $Context()
macro wing
   with ($x: y)
   end
end

$wing()
a
/// Output
a
/// End

/// Test locale fr en
with ($plume.locale: fr)
    - $plume.locale()
end
with ($plume.locale: en)
    - $plume.locale()
end
/// Output
(fr, en)
/// End

/// Test context value in macro
let var = $Context(1)

macro Wing
    $var()
end

$Wing()
/// Output
1
/// End

/// Test context with macro
let wing = $Context()
let nib = macro ()
end
with ($wing:5)
  $nib()
end
a
/// Output
a
/// End

/// Test context set table
let result
let wing = $Context()
with ($wing: 5)
    set result = $Table()
end
$result
/// Output
$Table()
/// End

/// Test context raise attempt
let a = $Context(a)

macro wing
    with ($a: b)
        raise Error!
    end
end

let result = $ attempt(wing)
$a()
/// Output
a
/// End

/// Test locale number
with ($plume.locale: 5)
end
a\n
/// Output
a
/// End

/// Test context dynamic key
let key = 1
let a = $Context(1$key)
/// Output
/// End
