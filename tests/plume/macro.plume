/// Test ref macro call
ref wing: macro
   Wing!
end

nib: macro
   $wing()$wing()
end
/// Output
(wing: macro<wing>, nib: macro<nib>)
/// End

/// Test ref macro config
ref nib: macro()
	ref wing: a
	config: $wing
end

run $nib()
/// Output
(nib: macro<nib>)
/// End

/// Test type of macro
let x
macro wing()
    $x
end

$type($wing)
/// Output
macro
/// End

/// Test success
macro double(x)
  $(x*2)
end

$attempt($double, 2)
/// Output
(success: true, result: 4)
/// End

/// Test fail
macro double(x)
  $(x*2)
end

$attempt($double, a)
/// Output
(success: false, result: Cannot convert the string value 'a' to a number.)
/// End

/// Test fail - long callstack
macro double(x)
  $(x*2)
end

macro nib()
  $double(a)
end

macro wing()
  $nib()
end

$attempt($wing)
/// Output
(success: false, result: Cannot convert the string value 'a' to a number.)
/// End

/// Test attempt macro raise
macro wing(a)
    raise Error!
end

a
let result = $attempt($wing, a)
/// Output
a
/// End

/// Test attempt String
$attempt($String, a)
/// Output
(success: true, result: a)
/// End

/// Test attempt Math.sin
$attempt($Math.sin, a)
/// Output
(success: false, result: Wrong type 'string' for parameter '1' of macro 'sin'. Expected: 'number'.
Usage: `\$sin(number x, ?deg, ?rad)`)
/// End

