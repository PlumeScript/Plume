/// Test leave in for if
macro wing()
    a
    for i in seq(4)
        if true
            b
            leave
        end
    end
end

$wing()
/// Output
ab
/// End

/// Test leave nested do
do
    a
    do
        a
        $(1+1)
        leave
        c
    end
    d
end
/// Output
aa2d
/// End

/// Test leave in do if
let var1 = 0
while var1 < 4
  set var1 += 1
  do
    if false
      a
    end
    leave
  end
end
/// Output
/// End

/// Test leave macro in loop
macro var5(x)
  leave
end
for var4 in seq(4)
  do
    if true
      $var5(x)
    end
    if true
      leave
    end
  end
end
/// Output
/// End

