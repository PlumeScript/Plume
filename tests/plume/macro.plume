/// Test simple macro & call
macro quill()
  mark
end
$quill()
/// Output
mark
/// End

/// Test macro & call (1 param)
macro double(write)
  $write $write
end
$double(quill)
/// Output
quill quill
/// End

/// Test macro & call (2 params)
macro f(write, paint)
  $write $paint
end
$f(quill, mark)
/// Output
quill mark
/// End

/// Test macro & call (named params)
macro f(optn: value)
  $optn
end
$f()\n
$f(optn: another value)
/// Output
value
another value
/// End

/// Test macro & call (miwriteed params)
macro f(write, paint, optn: value)
  $write $paint $optn
end
$f(quill, mark)\n
$f(quill, ink, optn: another value)
/// Output
quill mark value
quill ink another value
/// End

/// Test no parenthesis
macro quill
  mark
end
$quill()
/// Output
mark
/// End


/// Test macro scope
let _write = 5
macro f()
  let _write = 3
  $_write
end
$f()\n
$_write
/// Output
3
5
/// End

/// Test macro nested
macro double(write)
  $write $write
end

$double($double(quill))
/// Output
quill quill quill quill
/// End

/// Test long argument
macro id(write)
  $write
end

$id(This is quite long\, i think.)
/// Output
This is quite long, i think.
/// End

/// Test Variadic 1
macro write(...args)
  Positionals args: $Table.join(sep:\,\s, ...List($args))\n
  Named args:\s
  @Table.join(sep:\,\s)
    for key, value in items(args, ?named)
      - $key\0=$value
    end
  end
end
$write(write, paint, song, ink: quill, wing: mark)
/// Output
Positionals args: write, paint, song
Named args: ink=quill, wing=mark
/// End

/// Test Flag
macro write(?flag)
  if flag
    paint
  else
    sing
  end
end
$write()\n
$write(?flag)
/// Output
sing
paint
/// End

/// Test Leave macro (text)
let t = do
  - blue
  - red
  - green
end

macro index(t, y)
  Search...\n
  for i in seq(1, len(t))
    if t[i] == y
      $i
      leave
    end
  end
end

$index($t, red)
/// Output
Search...
2
/// End

/// Test Leave macro (Table)
macro t()
  content: wing
  leave
  content: nib
end

$t().content
/// Output
wing
/// End

/// Test Leave file
Nib
leave
Wing
/// Output
Nib
/// End

/// Test Table as default value
macro Wing(a:(a, b, c))
  $Table.join(...a)
end
$Wing()
/// Output
abc
/// End

/// Test Validator 1
macro wing(Number x)
  $(type(x))
end

$wing(1)
/// Output
number
/// End

/// Test Validator 2
macro wing(Number x)
  $(type(x))
end

let x = $(String(1))
$(type(x))\n
$(wing(x))
/// Output
string
number
/// End

/// Test Validator 3
macro wing(Number x: 0)
  $(type(x))
end

let x = $(String(1))
$(type(x))\n
$(wing(x: x))
/// Output
string
number
/// End

/// Test Validator 4
macro wing(Number x: $String(0))
  $(type(x))
end

$wing()
/// Output
number
/// End

/// Test Validator custom
macro double(x)
  $(2*x)
end

macro wing(double x)
  $x
end

$wing(5)
/// Output
10
/// End

/// Test Validator custom (via meta)
let double = do
  meta validate: macro(x)
    $x$x
  end
end

macro wing(double x)
  $x
end

$wing(5)
/// Output
55
/// End

/// Test Table validator
macro wing(Table x)
  $len($x)
end

$wing((5, 6, 7))
/// Output
3
/// End

/// Test short macro 1
let double = macro (x) $(2*x)

$double(5)
/// Output
10
/// End

/// Test short macro 2
macro double (x) $(2*x)

$double(5)
/// Output
10
/// End

/// Test short macro as expr
(1, 2, macro (x) $(2*x), 3)
/// Output
(1, 2, macro<???>, 3)
/// End

/// Test empty macro body
macro css(selector, ...style)
	for item in items(style)
	end
end

macro Document(body)
	@css(a)
		margin: 0
	end
end

@Document
	aaaaaaaaaaaaa
end
/// Output
/// End

/// Test variadic counter
macro List(...items)
    let count = 0
    for item in items
        set count += 1
        $count)$item\n
    end
end

@List
    - mark
    - paint
    - sing
end
/// Output
1)mark
2)paint
3)sing
/// End

/// Test macro call in eval
macro wing(body)
    $body
end

$(wing("a"))
/// Output
a
/// End

/// Test macro block local
macro Wing(body)
    $body
end

@Wing()
    let nex = 0
    for k in seq(1, 1)
        $nex
    end
end

/// Output
0
/// End

