let a = -1
if a > 2
  quill
end
/// Output
/// End

/// Test if-else true
let a = 5
if a > 2
  quill
else
  mark
end
/// Output
quill
/// End

/// Test if-else false
let a = -1
if a > 2
  quill
else
  mark
end
/// Output
mark
/// End

/// Test if-elseif-elseif-else 1
let a = 0
if a == 0
  quill
elseif a == 1
  mark
elseif a == 2
  ink
else
  ???
end
/// Output
quill
/// End

