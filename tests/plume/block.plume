/// Test if value text
let a = wing
let b = nib

let c = if true
    $a $b
end

$c
/// Output
wing nib
/// End

/// Test if empty value
let x = if true
end

$(x==empty)
/// Output
true
/// End

/// Test if tuple value
if true
    (1, 2, 3)
else
    (4, 5, 6)
end
/// Output
(1, 2, 3)
/// End

/// Test if tuple value let
if true
    let x
    (1, 2, 3)
else
    (4, 5, 6)
end
/// Output
(1, 2, 3)
/// End

/// Test if else text
if false
    
else
    a
    a
end
/// Output
aa
/// End

/// Test if elseif
if true
  a
elseif true
end
/// Output
a
/// End

/// Test two if false
if false
    a
end
    
if false
    a
end
/// Output
/// End

/// Test run side effect
let x = 1

macro incX()
  set x += 1
  $x
end

run $incX()
$x

/// Output
2
/// End


/// Test run block
let x = 1

macro incX(body)
  set x += 1
  $x
end

run @incX()
	Wings
end
/// Output
/// End

/// Test run nothing
run nothing
/// Output

/// End
