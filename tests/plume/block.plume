/// Test run side effect
let x = 1

macro incX
  set x += 1
  $x
end

run $incX()
$x

/// Output
2
/// End


/// Test run block
let x = 1

macro incX(body)
  set x += 1
  $x
end

run @incX()
	Wings
end
/// Output
/// End

/// Test run nothing
run nothing
/// Output

/// End

/// Test inline block call - simple
macro double(x)
  $x $x
end

 @double wing
/// Output
wing wing
/// End

/// Test inline block call - chained
macro double(x)
  $x $x
end

 @double @double wing
/// Output
wing wing wing wing
/// End

/// Test inline block call - with args
macro rep(x, count: 2)
  for i in seq(count)
    $x
  end
end

 @rep(count: 6) wing
/// Output
wingwingwingwingwingwing
/// End

/// Test inline block call - not at line start
macro double(x)
  $x$x
end

Double -> @double x
/// Output
Double -> xx
/// End

/// Test @(...) block call
macro double(x)
  $x$x
end
macro getCall()
  $double
end

@(getCall())
  wing
end
/// Output
wingwing
/// End

/// Test @(...) Table constructor equivalence
let a = @Table
  - x
end
let b = @(Table)
  - x
end
$type($a)\n
$len($a)\n
$type($b)\n
$len($b)
/// Output
table
1
table
1
/// End

/// Test @(...) with inline args
macro double(x, sep:)
  $x$sep$x
end

@(double)(sep: -)
  x
end
/// Output
x-x
/// End

/// Test @(...) multi-line expression
macro getCall()
  $Table
end

let t = @(
  getCall()
)
  - a
  - b
end
$len($t)\n
$t[1]
/// Output
2
a
/// End

/// Test @(...) chained block call
macro double(x)
  $x$x
end

@(double) @(double)
  x
end
/// Output
xxxx
/// End

/// Test @(...) chained with indexed macro
let t = @(Table) @Math.cos
  0
end
$len($t)\n
$t[1]
/// Output
1
1
/// End

/// Test @(...) table expansion
macro getCall()
  $Table
end

...@(getCall())
  - a
  - b
end
/// Output
(a, b)
/// End

/// Test block call - mid-line, text before
macro block(content)
  [BLOCK:$content]
end

Intro @block
  body line
end
/// Output
Intro [BLOCK:body line]
/// End

/// Test block call - mid-line, args on call line
macro wrap (tag, content, class:)
  <$tag class="$class">$content</$tag>
end

Intro @wrap(b, class: note)
  Sharp nib
end
/// Output
Intro <b class="note">Sharp nib</b>
/// End

/// Test block call - mid-line, table body
macro wrap (tag, content, class:)
  <$tag class="$class">$content</$tag>
end

Intro @wrap(class: note)
  - b
  - Sharp nib
end
/// Output
Intro <b class="note">Sharp nib</b>
/// End

/// Test block call - mid-line, in let value
macro block(content)
  [B:$content]
end

let x = value @block
  body
end
$x
/// Output
value [B:body]
/// End

/// Test block call - mid-line, escaped @ stays text
a \@b
/// Output
a @b
/// End

/// Test block call - mid-line, in inline call body
macro outer(x)
  [O:$x]
end
macro inner(content)
  [I:$content]
end

@outer intro @inner
  corps
end
after
/// Output
[O:intro [I:corps]]after
/// End

/// Test block call - mid-line, in inline call body, last line
macro outer(x)
  [O:$x]
end
macro inner(content)
  [I:$content]
end

@outer intro @inner
  corps
end
/// Output
[O:intro [I:corps]]
/// End

