/// Test #358
macro wing(x)
    set x.y = $Table()
end
macro nib
    y: $empty

    meta call: macro()
        if not self.y
            $ wing(self)
        end

        a
    end
end

let t = $nib()
$t()$t()
/// Output
aa
/// End

