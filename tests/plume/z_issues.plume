$(a
// one
// two
/* three
lines */
+1
)
/// Output
2
/// End

/// Test #1283-3 comment after operator and before closing paren
let a = 1
$(a
+ // after plus
1 // trailing
)
/// Output
2
/// End

/// Test #1283-4 comment inside a call in eval
let a = 1
$(len((a,
// between
1)))
/// Output
2
/// End

/// Test #1283-5 comment inside dynamic block call
let double = macro (x) $(2 * x)
let b = @(double
// target comment
)
    - 5
end
$b
/// Output
10
/// End

