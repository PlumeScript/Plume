/// Test #358
macro wing(x)
    set x.y = $Table()
end
macro nib
    y: $empty

    meta call: macro()
        if not self.y
            $ wing(self)
        end

        a
    end
end

let t = $nib()
$t()$t()
/// Output
aa
/// End

/// Test #853-1
let a = $Context(a)

$a()
for i in seq(10)
    with ($a: b)
        $a()
        break
    end
end

$a()
/// Output
aba
/// End

/// Test #853-2
let a = $Context(a)

$a()
while true
    with ($a: b)
        $a()
        break
    end
end

$a()
/// Output
aba
/// End

