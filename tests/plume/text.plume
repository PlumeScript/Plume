/// Test Line eval 1
use #future(lineEval)
$ 1+1
/// Output
2
/// End

/// Test Line eval 2
use #future(lineEval)
let x = 1
macro wing()
    set x += 1
end

run $ wing()
$x
/// Output
2
/// End

/// Test Line eval 3
use #future(lineEval)
let x = $ 1+1
$x
/// Output
2
/// End

/// Test Line eval 4
use #future(lineEval)
- $ 1+1
/// Output
$Table(2)
/// End

