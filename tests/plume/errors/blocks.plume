/// Test leave inside raise
raise do
	Fail!
	leave
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use leave keyword inside a `raise` block.                             │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    2 │ Fail!                                                                   │
│    3 │ leave                                                                   │
│      │ ^^^^^                                                                   │
│    4 │end                                                                      │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test break inside raise
for i in seq(2)
	raise do
		Fail!
		break
	end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use break keyword inside a `raise` block.                             │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    3 │ Fail!                                                                   │
│    4 │ break                                                                   │
│      │ ^^^^^                                                                   │
│    5 │end                                                                      │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test break outside loop
for i in seq(3)
    macro wing
        macro nib
        end
        break
    end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use break keyword outside a loop.                                     │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    2 │macro wing                                                               │
│    4 │    end                                                                  │
│    5 │    break                                                                │
│      │    ^^^^^                                                                │
│    6 │end                                                                      │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test continue in affectation
let var1 = 0
while var1 < 4
  set var1 += 1
  let var2 = do
    a
    continue
  end
end
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use continue keyword inside an affectation.                           │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    5 │  a                                                                      │
│    6 │  continue                                                               │
│      │  ^^^^^^^^                                                               │
│    7 │end                                                                      │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test continue in do block
for var1 in seq(4)
  do
    continue
    a
  end
end
