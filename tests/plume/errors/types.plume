/// Test macro wrong arg count
let x = macro()
end

$x(1)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Wrong number of positional arguments for macro 'x', 1 instead of 0.          │
│   Usage: $x()                                                                  │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    2 │end                                                                      │
│    4 │$x(1)                                                                    │
│      │ ^^^^                                                                    │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test Table.join wrong type
$Table.join($Table())
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Wrong type 'table' for parameter '1' of macro 'join'.                        │
│   Did you write `Table.join($t)` instead of `Table.join(...t)`?                │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$Table.join($Table())                                                    │
│      │ ^^^^^^^^^^^^^^^^^^^^                                                    │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test replace macro wrong arg
let x = x
macro rep
    $x
end

$("aaa").replace(a, $rep)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Macro sub for `String.replace` must take exactly '1' argument, not '0'.      │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    4 │end                                                                      │
│    6 │$("aaa").replace(a, $rep)                                                │
│      │ ^^^^^^^^^^^^^^^^^^^^^^^^                                                │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

