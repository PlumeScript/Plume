/// Test Add string
let x = Wings
$ x+1
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Cannot convert the string value 'Wings' to a number.                         │
│   (i) Consider using the `..` concat operator.                                 │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │let x = Wings                                                            │
│    2 │$ x+1                                                                    │
│      │  ^^^                                                                    │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

