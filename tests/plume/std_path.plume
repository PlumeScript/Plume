/// Test existing dir
let path = $os.Path(tests)
$path.isDirectory() - $path.isFile() - $path.exists()
/// Output
true - false - true
/// End

/// Test existing file
let path = $os.Path(tests/plume/meta.plume)
$path.isDirectory() - $path.isFile() - $path.exists()
/// Output
false - true - true
/// End

/// Test concat 1
let path = $os.Path(tests)
$(path / "wing") - $("wing" / path) - $(path / path)
/// Output
tests/wing - wing/tests - tests/tests
/// End

/// Test concat 2
let path = $os.Path(tests)
$String($(path / "wing/nib"))
/// Output
tests/wing/nib
/// End

