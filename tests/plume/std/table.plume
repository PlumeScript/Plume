/// Test List
let t = (1, 2, a: b)
$List($t)
/// Output
(1, 2)
/// End

/// Test Map
let t = (1, 2, a: b)
$Map($t)
/// Output
(a: b)
/// End

/// Test List as validator
macro wing(List t)
	$t
end
let t = (1, 2, a: b)
$wing($t)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Validator 'List' failed:                                                     │
│   Received extra named argument 'a', but extra arguments must be positional.   │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing(List t)                                                       │
│      │           ^^^^^^                                                        │
│    2 │ $t                                                                      │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ (same file)                                                                 │
│    5 │$wing($t)                                                                │
│      │ ^^^^^^^^                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test Map as validator
macro wing(Map t)
	$t
end
let t = (1, 2, a: b)
$wing($t)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Validator 'Map' failed:                                                      │
│   Received an extra positional argument, but extra arguments must be named.    │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing(Map t)                                                        │
│      │           ^^^^^                                                         │
│    2 │ $t                                                                      │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ (same file)                                                                 │
│    5 │$wing($t)                                                                │
│      │ ^^^^^^^^                                                                │
