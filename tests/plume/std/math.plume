/// Test Math.cos zero
$Math.cos(0).round()
/// Output
1
/// End

/// Test Math.cos pi
$Math.cos($Math.pi).round()
/// Output
-1
/// End

/// Test Math.cos 180 degrees
$Math.cos(180, ?deg).round()
/// Output
-1
/// End

/// Test Math.sin zero
$Math.sin(0).round()
/// Output
0
/// End

/// Test Math.sin pi half
$Math.sin($(Math.pi / 2)).round()
/// Output
1
/// End

/// Test Math.sin 90 degrees
$Math.sin(90, ?deg).round()
/// Output
1
/// End

/// Test Math.tan zero
$Math.tan(0).round()
/// Output
0
/// End

/// Test Math.tan pi quarter
$Math.tan($(Math.pi / 4)).round()
/// Output
1
/// End

/// Test Math.tan 45 degrees
$Math.tan(45, ?deg).round()
/// Output
1
/// End

/// Test Math.acos
$Math.acos(1).round()
/// Output
0
/// End

/// Test Math.acos zero
$Math.acos(0).round(digit: 4)
/// Output
1.5708
/// End

/// Test Math.acos zero degrees
$Math.acos(0, ?deg).round()
/// Output
90
/// End

/// Test Math.asin zero
$Math.asin(0).round()
/// Output
0
/// End

/// Test Math.asin one
$Math.asin(1).round(digit: 4)
/// Output
1.5708
/// End

/// Test Math.asin one degrees
$Math.asin(1, ?deg).round()
/// Output
90
/// End

/// Test Math.atan zero
$Math.atan(0).round()
/// Output
0
/// End

/// Test Math.atan one
$Math.atan(1).round(digit: 4)
/// Output
0.7854
/// End

/// Test Math.atan one degrees
$Math.atan(1, ?deg).round()
/// Output
45
/// End

/// Test Math.atan2 diagonal
$Math.atan2(1, 1).round(digit: 4)
/// Output
0.7854
/// End

/// Test Math.atan2 diagonal degrees
$Math.atan2(1, 1, ?deg).round()
/// Output
45
/// End

/// Test rad flag
let r = $Random()
let angle = $r()
$ Math.cos(angle) == $Math.cos(angle, ?rad)
/// Output
true
/// End

/// Test both rad and deg flags
$Math.cos(0, ?deg, ?rad)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Cannot use `?deg` and `?rad` flags together.                                 │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$Math.cos(0, ?deg, ?rad)                                                 │
│      │ ^^^^^^^^^^^^^^^^^^^^^^^                                                 │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test Math.log one
$Math.log(1).round()
/// Output
0
/// End

/// Test Math.log e
$Math.log($Math.e).round()
/// Output
1
/// End

/// Test Math.log10 one
$Math.log10(1).round()
/// Output
0
/// End

/// Test Math.log10 thousand
$Math.log10(1000).round()
/// Output
3
/// End

/// Test $Math.pi
$Math.pi.round(digit: 5)
/// Output
3.14159
/// End

/// Test Math.e
$Math.e.round(digit: 5)
/// Output
2.71828
/// End

/// Test Math.huge
if Math.huge > 10 ^ 300
    huge
else
    not huge
end
/// Output
huge
/// End
