/// Test nodoc
macro wing()
end

$plume.doc($wing)
/// Output
macro wing
/// End


/// Test simpledoc
// a macro that fly
macro wing()
end

$plume.doc($wing)
/// Output
macro wing
    a macro that fly
/// End

/// Test closure
let x
macro wing()
	$x
end

$plume.doc($wing)
/// Output
macro wing
/// End


/// Test macro as value
// a macro that fly
let wing = macro ()
end

$plume.doc($wing)
/// Output
macro wing
    a macro that fly
/// End

/// Test macro as table value
// a macro that fly
let t = do
	wing: macro ()
	end
end

$plume.doc($t.wing)
/// Output
macro wing
    a macro that fly
/// End

/// Test macro as ref table value
// a macro that fly
let t = do
	ref wing: macro ()
	end
end

$plume.doc($t.wing)
/// Output
macro wing
    a macro that fly
/// End