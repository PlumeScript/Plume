/// Test raise 2
macro wing()
	raise Error!
end
$wing()
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Error!                                                                       │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing()                                                             │
│    2 │ raise Error!                                                            │
│      │ ^^^^^^^^^^^^                                                            │
│    3 │end                                                                      │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ (same file)                                                                 │
│    4 │$wing()                                                                  │
│      │ ^^^^^^                                                                  │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test attempt 1
macro wing()
	raise Error!
end
$attempt($wing)
/// Output
(success: false, result: Error!)
/// End

/// Test attempt 2
macro wing()
	No error!
end
$attempt($wing)
/// Output
(success: true, result: No error!)
/// End

/// Test eval 1
$eval(1+1)
/// Output
1+1
/// End

/// Test eval 2
$eval(\$(1+1))
/// Output
2
/// End

/// Test eval error 1
$eval(\$(1+a))
/// Error
