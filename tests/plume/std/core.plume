/// Test type 1
$type((1, 2))
/// Output
table
/// End

/// Test type 2
$type(a)
/// Output
string
/// End

/// Test type 3
$type(4)
/// Output
number
/// End

/// Test len
$len((1, 2, a: b))
/// Output
2
/// End

/// Test repr 1
$repr((1, 2, a: b))
/// Output
(1, 2, a: b)
/// End

/// Test repr 2
$repr((1, 2, a: (b, c, d)))
/// Output
(1, 2, a: (b, c, d))
/// End

/// Test Number 1
$Number(1)
/// Output
1
/// End

/// Test Number 2
$Number(a)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Cannot convert string into number                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$Number(a)                                                               │
│      │ ^^^^^^^^^                                                               │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test String
$ type(String(1))
/// Output
string
/// End

/// Test raise 1
raise Error!
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Error!                                                                       │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │raise Error!                                                             │
│      │^^^^^^^^^^^^                                                             │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test raise 2
macro wing
	raise Error!
end
$wing()
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Error!                                                                       │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │macro wing                                                               │
│    2 │ raise Error!                                                            │
│      │ ^^^^^^^^^^^^                                                            │
│    3 │end                                                                      │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ (same file)                                                                 │
│    4 │$wing()                                                                  │
│      │ ^^^^^^                                                                  │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test attempt 1
macro wing
	raise Error!
end
$ attempt(wing)
/// Output
(success: false, result: Error!)
/// End

/// Test attempt 2
macro wing
	No error!
end
$ attempt(wing)
/// Output
(success: true, result: No error!)
/// End

/// Test eval 1
$eval(1+1)
/// Output
1+1
/// End

/// Test eval 2
$eval(\$(1+1))
/// Output
2
/// End

/// Test eval error 1
$eval(\$(1+a))
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use variable 'a', it isn't defined in the current scope.              │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ <string>                                                                    │
│    1 │$(1+a)                                                                   │
│      │    ^                                                                    │
│                                                                                │
├────────────────────────────────────────────────────────────────────────────────┤
│ Traceback (most recent call first):                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│  ↳ test.plume                                                                  │
│    1 │$eval(\$(1+a))                                                           │
│      │ ^^^^^^^^^^^^^                                                           │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test eval error 2
$eval(\$(1+a), ?safe)
/// Output
(success: false, result: ╭────────────────────────────────────────────────────────────────────────────────╮
│ COMPILATION ERROR:                                                             │
│ → Cannot use variable 'a', it isn't defined in the current scope.              │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ <string>                                                                    │
│    1 │\$(1+a)                                                                   │
│      │    ^                                                                    │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯)
/// End

/// Test lua.eval 1
$lua.eval(return 1)
/// Output
1
/// End

/// Test lua.eval 2
$lua.eval(return 1+1)
/// Output
2
/// End

/// Test lua.eval error 1
$lua.eval(return 1+a)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → [string "return 1+a"]:1: attempt to perform arithmetic on global 'a' (a      │
│   nil value)                                                                   │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$lua.eval(return 1+a)                                                    │
│      │ ^^^^^^^^^^^^^^^^^^^^                                                    │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test lua.eval error 2
$lua.eval(return 1+a, ?safe)
/// Output
(success: false, result: [string "return 1+a"]:1: attempt to perform arithmetic on global 'a' (a nil value))
/// End

/// Test lua.eval exotic
$lua.eval(return function()end)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → The lua code returned  a 'function' object, that cannot be converted         │
│   into Plume object.                                                           │
│   (i) For now, only `string`, `number`, `boolean` and `nil` return are         │
│   supported.                                                                   │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$lua.eval(return function()end)                                          │
│      │ ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^                                          │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test std are readonly
set Math.sin = $Math.cos
/// Error
