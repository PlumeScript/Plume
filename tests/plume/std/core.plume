/// Test type 1
$type((1, 2))
/// Output
table
/// End

/// Test type 2
$type(a)
/// Output
string
/// End

/// Test type 3
$type(4)
/// Output
number
/// End

/// Test len
$len((1, 2, a: b))
/// Output
2
/// End

/// Test repr 1
$repr((1, 2, a: b))
/// Output
(1, 2, a: b)
/// End

/// Test repr 2
$repr((1, 2, a: (b, c, d)))
/// Output
(1, 2, a: (b, c, d))
/// End

/// Test Number 1
$Number(1)
/// Output
1
/// End

/// Test Number 2
$Number(a)
/// Error
╭────────────────────────────────────────────────────────────────────────────────╮
│ RUNTIME ERROR:                                                                 │
│ → Cannot convert string into number                                            │
├────────────────────────────────────────────────────────────────────────────────┤
│                                                                                │
│  ↳ test.plume                                                                  │
│    1 │$Number(a)                                                               │
│      │ ^^^^^^^^^                                                               │
│                                                                                │
╰────────────────────────────────────────────────────────────────────────────────╯
/// End

/// Test String
$type($String(1))
/// Output
string
/// End

